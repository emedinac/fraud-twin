{
  "type": "record",
  "name": "PaymentEvent",
  "namespace": "fraudtwin.events.v1",
  "doc": "Observable payment and payment-lifecycle event.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string"},
    {"name": "event_version", "type": "int"},
    {"name": "payment_id", "type": "string"},
    {"name": "customer_id", "type": "string"},
    {"name": "account_id", "type": "string"},
    {"name": "event_time", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "source_created_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "source_available_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "ingested_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "processed_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "producer", "type": "string"},
    {"name": "source_system", "type": "string"},
    {"name": "schema_version", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "causation_id", "type": ["null", "string"], "default": null},
    {"name": "simulation_run_id", "type": "string"},
    {"name": "scenario_id", "type": ["null", "string"], "default": null},
    {"name": "payment_rail", "type": "string"},
    {"name": "payment_type", "type": "string"},
    {"name": "payee_account_id", "type": ["null", "string"], "default": null},
    {"name": "merchant_id", "type": ["null", "string"], "default": null},
    {"name": "card_id", "type": ["null", "string"], "default": null},
    {"name": "device_id", "type": ["null", "string"], "default": null},
    {"name": "ip_id", "type": ["null", "string"], "default": null},
    {"name": "transport_partition", "type": ["null", "int"], "default": null},
    {"name": "online", "type": "boolean"},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 2}},
    {"name": "currency", "type": "string"},
    {"name": "scenario_type", "type": ["null", "string"], "default": null},
    {"name": "scenario_trigger", "type": ["null", "string"], "default": null},
    {"name": "scenario_reason", "type": ["null", "string"], "default": null},
    {"name": "fraud_record_id", "type": ["null", "string"], "default": null},
    {"name": "affected_entity_ids", "type": {"type": "array", "items": "string"}, "default": []}
  ]
}
