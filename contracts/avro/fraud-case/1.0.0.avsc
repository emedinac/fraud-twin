{
  "type": "record",
  "name": "FraudCase",
  "namespace": "fraudtwin.events.v1",
  "doc": "Observable fraud investigation case; latent fraud truth is intentionally absent.",
  "fields": [
    {"name": "fraud_case_id", "type": "string"},
    {"name": "fraud_alert_id", "type": "string"},
    {"name": "customer_id", "type": "string"},
    {"name": "account_id", "type": ["null", "string"], "default": null},
    {"name": "card_id", "type": ["null", "string"], "default": null},
    {"name": "device_id", "type": ["null", "string"], "default": null},
    {"name": "merchant_id", "type": ["null", "string"], "default": null},
    {"name": "payment_id", "type": "string"},
    {"name": "event_id", "type": "string"},
    {"name": "fraud_record_id", "type": "string"},
    {"name": "scenario_id", "type": "string"},
    {"name": "scenario_type", "type": "string"},
    {"name": "fraud_occurred_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "alert_created_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "case_opened_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "case_closed_at", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null},
    {"name": "fraud_confirmed_at", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null},
    {"name": "label_available_at", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null},
    {"name": "investigation_outcome", "type": "string"},
    {"name": "loss_amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 2}},
    {"name": "recovered_amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 2}},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 2}},
    {"name": "currency", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "causation_id", "type": "string"},
    {"name": "simulation_run_id", "type": ["null", "string"], "default": null},
    {"name": "affected_entity_ids", "type": {"type": "array", "items": "string"}, "default": []},
    {"name": "case_reopened_at", "type": ["null", {"type": "long", "logicalType": "timestamp-micros"}], "default": null}
  ]
}
