{
  "type": "record",
  "name": "FraudAlert",
  "namespace": "fraudtwin.events.v1",
  "doc": "Observable automated fraud alert.",
  "fields": [
    {"name": "fraud_alert_id", "type": "string"},
    {"name": "alert_type", "type": "string"},
    {"name": "severity", "type": "string"},
    {"name": "customer_id", "type": "string"},
    {"name": "account_id", "type": ["null", "string"], "default": null},
    {"name": "card_id", "type": ["null", "string"], "default": null},
    {"name": "device_id", "type": ["null", "string"], "default": null},
    {"name": "merchant_id", "type": ["null", "string"], "default": null},
    {"name": "payment_id", "type": "string"},
    {"name": "event_id", "type": "string"},
    {"name": "fraud_record_id", "type": "string"},
    {"name": "scenario_id", "type": "string"},
    {"name": "scenario_type", "type": "string"},
    {"name": "trigger", "type": "string"},
    {"name": "reason", "type": "string"},
    {"name": "alert_created_at", "type": {"type": "long", "logicalType": "timestamp-micros"}},
    {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 18, "scale": 2}},
    {"name": "currency", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "causation_id", "type": "string"},
    {"name": "simulation_run_id", "type": ["null", "string"], "default": null},
    {"name": "affected_entity_ids", "type": {"type": "array", "items": "string"}, "default": []}
  ]
}
